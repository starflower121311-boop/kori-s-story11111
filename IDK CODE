<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Kori's Story</title>

<style>
* { box-sizing: border-box; }

:root {
    --background: #f7f7f7;
    --panel: #fff;
    --text: #303030;
    --muted: #777;
    --border: #bdbdbd;
    --button: #eee;
    --button-hover: #dedede;
}

body {
    margin: 0;
    min-height: 100vh;
    padding: 30px 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--background);
    color: var(--text);
    font-family: Georgia, "Times New Roman", serif;
    transition: background 2s, color 2s;
}

#game {
    width: 100%;
    max-width: 760px;
    text-align: center;
}

#language-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 22px;
}

#language-toggle {
    width: auto;
    min-width: 125px;
    padding: 9px 15px;
    font-size: 12px;
}

#chapter {
    margin-bottom: 12px;
    color: var(--muted);
    font: 11px Arial, sans-serif;
    letter-spacing: 5px;
    text-transform: uppercase;
}

h1 {
    margin: 0 0 25px;
    font-size: clamp(27px, 5vw, 42px);
    font-weight: normal;
    letter-spacing: 2px;
}

#scene {
    min-height: 200px;
    padding: 24px;
    background: var(--panel);
    border: 1px solid var(--border);
    box-shadow: 7px 7px 0 rgba(0,0,0,.06);
    transition: background 2s, border-color 2s;
}

#image-frame {
    width: min(100%, 440px);
    margin: 0 auto 24px;
    padding: 8px;
    border: 1px solid var(--border);
    background: rgba(0,0,0,.025);
}

#scene-image {
    display: block;
    width: 100%;
    max-height: 380px;
    object-fit: contain;
}

#image-error {
    display: none;
    padding: 20px 8px;
    color: #a33;
    font: 13px Arial, sans-serif;
    overflow-wrap: anywhere;
}

#story-text {
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.9;
    font-size: 16px;
    white-space: pre-line;
    overflow-wrap: anywhere;
}

#choices {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 480px;
    margin: 24px auto 0;
}

button {
    width: 100%;
    padding: 13px 16px;
    border: 1px solid var(--border);
    background: var(--button);
    color: inherit;
    font: 13px Arial, sans-serif;
    cursor: pointer;
    transition: background .2s, border-color .2s;
}

button:hover:not(:disabled) {
    background: var(--button-hover);
    border-color: #777;
}

button:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
}

#footer {
    margin-top: 20px;
    color: var(--muted);
    font: 10px Arial, sans-serif;
    letter-spacing: 2px;
}

body.corrupted {
    --background: #090909;
    --panel: #111;
    --text: #e2e2e2;
    --muted: #888;
    --border: #555;
    --button: #1b1b1b;
    --button-hover: #333;
}

body.corrupted #scene {
    box-shadow: 7px 7px 0 rgba(255,255,255,.035);
}

body.glitch #scene {
    animation: glitch .16s infinite;
}

body.glitch #chapter {
    color: #e0a0a0;
}

@keyframes glitch {
    0% { transform: translate(0,0); }
    25% { transform: translate(2px,-1px); }
    50% { transform: translate(-2px,1px); }
    75% { transform: translate(1px,2px); }
    100% { transform: translate(0,0); }
}

body.gloomy {
    --background: #292929;
    --panel: #353535;
    --text: #d0d0d0;
    --muted: #a0a0a0;
    --border: #666;
    --button: #424242;
    --button-hover: #555;
}

body.gloomy #scene {
    box-shadow: 7px 7px 0 rgba(0,0,0,.18);
}

/* Arabic layout */

body.arabic {
    font-family: Tahoma, Arial, sans-serif;
}

body.arabic #game {
    direction: rtl;
}

body.arabic #language-bar {
    justify-content: flex-start;
}

body.arabic #chapter {
    letter-spacing: 0;
    font-family: Tahoma, Arial, sans-serif;
}

body.arabic h1 {
    letter-spacing: 0;
}

body.arabic #story-text {
    text-align: right;
    line-height: 2;
    font-size: 17px;
}

body.arabic #choices button {
    text-align: right;
}

body.arabic #footer {
    letter-spacing: 0;
}

@media (max-width: 500px) {
    body {
        padding: 18px 10px;
        align-items: flex-start;
    }

    #scene {
        padding: 16px;
    }

    #story-text {
        font-size: 15px;
    }

    #image-frame {
        margin-bottom: 18px;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation-duration: .01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: .01ms !important;
    }
}
</style>
</head>

<body>
