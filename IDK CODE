const sceneImage = document.getElementById("scene-image");
const imageError = document.getElementById("image-error");
const languageToggle = document.getElementById("language-toggle");
const footer = document.getElementById("footer");

let sceneTimers = [];
let currentScene = 0;
let visitedLocations = [];
let currentStoryText = "";
let currentChapter = "A STORY";
let currentTitle = "Kori's Story";
let currentOptions = [];
let currentEnding = null;
let currentImageFilename = "";

const MAX_LOCATIONS = 2;

function translateOne(text) {
    if (language === "en") return text;

    const placesMatch = text.match(/^Places left to visit:\s*(\d+)$/);
    if (placesMatch) {
        return "الأماكن اللي باقي تزورينها: " + placesMatch[1];
    }

    return arabic[text] || text;
}

function translateText(text) {
    if (language === "en") return text;

    return text.split("\n\n").map(paragraph => {
        if (arabic[paragraph]) return arabic[paragraph];

        return paragraph.split("\n")
            .map(line => translateOne(line))
            .join("\n");
    }).join("\n\n");
}

function toggleLanguage() {
    language = language === "en" ? "ar" : "en";

    document.documentElement.lang = language;
    document.documentElement.dir = language === "ar" ? "rtl" : "ltr";
    document.body.classList.toggle("arabic", language === "ar");

    languageToggle.textContent = language === "en" ? "العربية" : "English";
    footer.textContent = language === "ar" ? "قصة كوري" : "KORI'S STORY";

    renderChapter();
    renderStoryText();
    renderChoices();

    if (imageError.style.display === "block" && currentImageFilename) {
        showImageError(currentImageFilename);
    }
}

function renderChapter() {
    chapterElement.textContent = translateOne(currentChapter);
    titleElement.textContent = translateOne(currentTitle);
}

function renderStoryText() {
    storyText.textContent = translateText(currentStoryText);
}

function renderChoices() {
    choicesElement.replaceChildren();

    currentOptions.forEach(option => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = translateOne(option.label);

        button.addEventListener("click", () => {
            clearChoices();
            clearSceneTimers();
            currentScene++;
            option.action();
        });

        choicesElement.appendChild(button);
    });

    if (currentEnding) {
        const endingTitle = document.createElement("h2");
        endingTitle.textContent = translateOne(currentEnding);
        endingTitle.style.fontWeight = "normal";
        endingTitle.style.letterSpacing = language === "ar" ? "0" : "4px";
        endingTitle.style.fontSize = "15px";
        endingTitle.style.marginTop = "28px";
        choicesElement.appendChild(endingTitle);

        const restartButton = document.createElement("button");
        restartButton.type = "button";
        restartButton.textContent = language === "ar" ? "ابدئي من جديد" : "Start over";
        restartButton.addEventListener("click", startGame);
        choicesElement.appendChild(restartButton);
    }
}

function clearSceneTimers() {
    sceneTimers.forEach(timer => clearTimeout(timer));
    sceneTimers = [];
}

function later(callback, delay) {
    const timer = setTimeout(() => {
        sceneTimers = sceneTimers.filter(item => item !== timer);
        callback();
    }, delay);

    sceneTimers.push(timer);
    return timer;
}

function clearChoices() {
    currentOptions = [];
    currentEnding = null;
    choicesElement.replaceChildren();
}

function setChoices(options) {
    currentEnding = null;
    currentOptions = options;
    renderChoices();
}

function setText(text) {
    currentStoryText = text;
    renderStoryText();
}

function setChapter(chapter, title) {
    currentChapter = chapter;
    currentTitle = title;
    renderChapter();
}

function resetAppearance() {
    document.body.classList.remove("corrupted", "glitch", "gloomy");
}

function showImageError(filename) {
    imageError.style.display = "block";
    imageError.textContent = language === "ar"
        ? "ما قدرنا نحمّل الصورة " + filename +
          ". تأكدي إنها موجودة بنفس مجلد index.html وإن اسم الملف صحيح."
        : "Couldn't load " + filename +
          ". Check that the GIF is in the same folder as index.html " +
          "and that its filename matches exactly.";
}

function showImage(filename, alt = "") {
    currentImageFilename = filename || "";

    sceneImage.onload = null;
    sceneImage.onerror = null;
    sceneImage.hidden = true;
    sceneImage.removeAttribute("src");
    sceneImage.alt = alt;

    imageError.style.display = "none";
    imageError.textContent = "";

    if (!filename) return;

    sceneImage.onerror = () => {
        sceneImage.hidden = true;
        showImageError(filename);
    };

    sceneImage.onload = () => {
        sceneImage.hidden = false;
        imageError.style.display = "none";
    };

    sceneImage.src = filename;
}

function scene(filename, text, choices, alt = "") {
    clearSceneTimers();
    showImage(filename, alt);
    setText(text);
    setChoices(choices);
}

function continueScene(filename, text, callback, alt = "") {
    scene(filename, text, [
        { label: "Continue", action: callback }
    ], alt);
}

/* ACT 1 — THE CAT */

function startGame() {
    clearSceneTimers();
    clearChoices();
    resetAppearance();

    setChapter("A STORY", "Kori's Story");
    showImage("", "");

    setText(
        "A girl stands in a place where nothing exists.\n\n" +
        "She doesn't know how she got here.\n\n" +
        "She doesn't remember anything at all.\n\n" +
        "What should she do?"
    );

    setChoices([
        { label: "Look around", action: () => meetCat("look") },
        { label: "Call out to someone", action: () => meetCat("call") },
        { label: "Try to move around", action: () => meetCat("move") }
    ]);
}

function meetCat(choice) {
    setChapter("ACT 1", "The Void");

    let text;

    if (choice === "look") {
        text =
            "Kori looks around.\n\n" +
            "There is nothing. No walls, no floor she can see, and no sign of another person.\n\n" +
            "Then, something catches her attention.";
    } else if (choice === "call") {
        text =
            "Kori calls out into the emptiness.\n\n" +
            "No one answers.\n\n" +
            "For a moment, she thinks she hears something nearby.";
    } else {
        text =
            "Kori tries to move through the empty space.\n\n" +
            "She doesn't know where she is going.\n\n" +
            "Then, she notices something in the distance.";
    }

    continueScene(
        "cat.gif",
        text + "\n\nA black cat sits quietly in front of her.",
        catChoices,
        "A black cat sitting in the void"
    );
}

function catChoices() {
    setChapter("ACT 1", "A Familiar Stranger");

    setText(
        "The cat looks at Kori.\n\n" +
        "It doesn't seem frightened of her. It simply sits there, watching."
    );

    setChoices([
        { label: "Speak to the cat", action: () => catInteraction("speak") },
        { label: "Pet the cat", action: () => catInteraction("pet") },
        { label: "Watch its tail wag", action: () => catInteraction("wagging") }
    ]);
}

function catInteraction(choice) {
    const scenes = {
        speak: {
            image: "speak.gif",
            text: "Kori tries speaking to the cat.\n\nIt doesn't answer, of course. Still, she finds herself waiting for a response."
        },
        pet: {
            image: "pet.gif",
            text: "Kori reaches out to pet the cat.\n\nThe cat allows it, although it doesn't move closer."
        },
        wagging: {
            image: "wagging.gif",
            text: "Kori watches the cat's tail sway.\n\nFor some reason, the sight feels strangely familiar."
        }
    };

    const selected = scenes[choice];

    continueScene(
        selected.image,
        selected.text,
        nextCatChoices,
        "Kori interacting with the black cat"
    );
}

function nextCatChoices() {
    setChapter("ACT 1", "Something Feels Familiar");

    setText(
        "The cat stands up.\n\n" +
        "Kori isn't sure why, but she doesn't want to lose sight of it."
    );

    setChoices([
        { label: "Stand still and listen", action: () => catEndingChoice("still") },
        { label: "Chase after the cat", action: () => catEndingChoice("runsaway") },
        { label: "Blink", action: () => catEndingChoice("blink") }
    ]);
}

function catEndingChoice(choice) {
    const scenes = {
        still: {
            image: "still.gif",
            text: "Kori stands still, listening.\n\nThe silence around her feels almost comforting."
        },
        runsaway: {
            image: "runsaway.gif",
            text: "The cat suddenly runs away.\n\nKori follows it before she can think about why."
        },
        blink: {
            image: "blink.gif",
            text: "Kori blinks.\n\nWhen she opens her eyes, the cat is gone.\n\nShe is alone again."
        }
    };

    const selected = scenes[choice];

    continueScene(
        selected.image,
        selected.text,
        startAct2,
        "Kori's encounter with the cat"
    );
}

/* ACT 2 — THE DOOR */

function startAct2() {
    clearSceneTimers();
    resetAppearance();
    setChapter("ACT 2", "The Door");

    scene(
        "Door.gif",
        "A door stands in front of you.\n\nYou don't remember it being there before.",
        [{ label: "Approach the door", action: beginCorruption }],
        "A mysterious door"
    );
}

function beginCorruption() {
    clearSceneTimers();
    document.body.classList.add("corrupted", "glitch");

    const messages = [
        "WELCOME TO HEAVEN.",
        "YOU ARE NOT SUPPOSED TO REMEMBER.",
        "DO YOU REMEMBER HIM?",
        "THE GLASS SHATTERED.",
        "SOMEONE CALLED YOUR NAME.",
        "HE DIDN'T MEAN TO...",
        "WHY ARE YOU STILL HERE?",
        "WELCOME TO HEAVEN."
    ];

    let index = 0;
    showImage("", "");
    setText("");

    function showNextMessage() {
        if (index >= messages.length) {
            document.body.classList.remove("glitch");
            setText("O P E N   I T");

            setChoices([
                { label: "Open the door", action: openDoor }
            ]);
            return;
        }

        setText(messages[index]);
        index++;
        later(showNextMessage, 850);
    }

    showNextMessage();
}

function openDoor() {
    clearSceneTimers();

    scene("open.gif", "You open the door.", [], "The door opening");

    later(() => {
        scene(
            "wag2.gif",
            "The cat watches you.\n\nIts tail sways slowly.",
            [],
            "The black cat waiting beyond the door"
        );

        later(showGabriel, 2500);
    }, 1600);
}

function showGabriel() {
    setChapter("ACT 2", "A Weeping Figure");

    scene(
        "child.gif",
        "A figure stands before you.\n\n" +
        "He doesn't speak. His face is difficult to make out, but tears continue to fall from his eyes.\n\n" +
        "He seems to be waiting for something.",
        [
            { label: "Watch him quietly", action: observeGabriel },
            { label: "Try asking him questions", action: askGabriel }
        ],
        "A weeping figure standing in the darkness"
    );
}

function observeGabriel() {
    continueScene(
        "tears.gif",
        "You watch him quietly.\n\n" +
        "He doesn't move toward you. He doesn't speak.\n\n" +
        "His eyes keep weeping, as if there is something he cannot tell you.",
        showHandsScene,
        "The figure's tearful eyes"
    );
}

function askGabriel() {
    continueScene(
        "answers.gif",
        "You try asking him questions.\n\n" +
        "Who is he? Where are you? Why is he crying?\n\n" +
        "He gives you no answer. Looking closer, you realize he has no mouth at all.\n\n" +
        "Only those tearful eyes.",
        showHandsScene,
        "The silent figure"
    );
}

function showHandsScene() {
    setChapter("ACT 2", "An Offer");

    scene(
        "hands.gif",
        "The figure slowly holds out his hands.\n\n" +
        "He still says nothing.\n\nWill you take them?",
        [
            { label: "Take his hands", action: takeHands },
            { label: "Walk away", action: refuseHands }
        ],
        "The figure holding out his hands"
    );
}

function takeHands() {
    continueScene(
        "walking.gif",
        "You take his hands.\n\n" +
        "He gently leads you away. You don't know where he is taking you, but he doesn't let go.",
        startAct3,
        "Kori walking with the silent figure"
    );
}

function refuseHands() {
    continueScene(
        "walk away.gif",
        "You turn and walk away.\n\n" +
        "The figure doesn't stop you.\n\n" +
        "Even after you leave, you can still feel his gaze following you.",
        startAct3,
        "Kori walking away"
    );
}

/* ACT 3 — EARTH */

function startAct3() {
    clearSceneTimers();
    resetAppearance();
    setChapter("ACT 3", "Somewhere Familiar");

    continueScene(
        "earth.gif",
        "The world changes around you.\n\n" +
        "The emptiness is gone. There is ground beneath your feet, and the air feels different.\n\n" +
        "You have arrived somewhere very familiar.\n\n" +
        "The figure stands beside you.",
        earthDialogue1,
        "Kori and Gabriel arriving on Earth"
    );
}

/* Dialogue is kept natural: no character-name labels. */

function earthDialogue1() {
    continueScene(
        "earth.gif",
        '"You\'re free to explore, my child..."',
        earthDialogue2,
        "Kori and Gabriel on Earth"
    );
}

function earthDialogue2() {
    continueScene(
        "earth.gif",
        '"You speak!?"\n\n' +
        "Kori looks up at him, startled. Until now, he hasn't said a single word.",
        earthDialogue3,
        "Kori reacting to Gabriel"
    );
}

function earthDialogue3() {
    continueScene(
        "earth.gif",
        '"Of course I do... I\'m an angel after all."',
        earthDialogue4,
        "Gabriel speaking to Kori"
    );
}

function earthDialogue4() {
    continueScene(
        "earth.gif",
        '"Well then, what\'s your name?"',
        earthDialogue5,
        "Kori asking Gabriel a question"
    );
}

function earthDialogue5() {
    continueScene(
        "earth.gif",
        '"Gabriel..."',
        startExploration,
        "Gabriel introducing himself"
    );
}

/* EXPLORATION */

const locations = [
    {
        id: "park",
        label: "Visit the park",
        image: "park.gif",
        description:
            "The park is loud. Trees sway gently in the breeze, She watches as familes laugh together.\n\n" +
            "She feels sad as she watches children play together."
    },
    {
        id: "garden",
        label: "Visit the garden",
        image: "garden.gif",
        description:
            "The garden is peaceful.\n\n" +
            "Kori watches the gardener cut some overgrown roses out of their bushes. " +
            "She slowly remembers how she wanted to try gardening, But, she was always too busy."
    },
    {
        id: "library",
        label: "Visit the library",
        image: "library.gif",
        description:
            "The library is filled with shelves of books.\n\n" +
            "Kori feels strangely drawn to them. She doesn't remember what she used to read, but the sight of all those books feels familiar."
    }
];

function startExploration() {
    visitedLocations = [];
    chooseLocation();
}

function chooseLocation() {
    setChapter("ACT 3", "Explore");

    if (visitedLocations.length >= MAX_LOCATIONS) {
        askGabrielToFollow();
        return;
    }

    const remaining = MAX_LOCATIONS - visitedLocations.length;

    setText(
        "Gabriel waits nearby while Kori looks around.\n\n" +
        "Where would you like to go?\n\n" +
        "Places left to visit: " + remaining
    );

    const availableLocations = locations.filter(
        place => !visitedLocations.includes(place.id)
    );

    setChoices(availableLocations.map(place => ({
        label: place.label,
        action: () => visitLocation(place)
    })));
}

function visitLocation(place) {
    if (visitedLocations.includes(place.id)) {
        chooseLocation();
        return;
    }

    visitedLocations.push(place.id);

    continueScene(
        place.image,
        place.description,
        chooseLocation,
        place.label
    );
}

/* GABRIEL'S REQUEST */

function askGabrielToFollow() {
    setChapter("ACT 3", "One More Place");

    scene(
        "a place.gif",
        "After Kori finishes exploring, Gabriel approaches her.\n\n" +
        '"Kori, there\'s somewhere else I\'d like to show you. ' +
        'It\'s a little far from here. Will you come with me?"',
        [
            { label: "Go with him", action: goWithGabriel },
            { label: "Stay here", action: stayHere }
        ],
        "Gabriel asking Kori to follow him"
    );
}

function stayHere() {
    clearSceneTimers();
    setChapter("ENDING 1", "Peace");

    scene(
        "stay here.gif",
        "Kori decides to stay.\n\n" +
        "Gabriel looks at her for a moment. His eyes still weep, but he doesn't try to change her mind.\n\n" +
        "He understands.\n\n" +
        "He lets her remain where she feels safe, then quietly leaves her to the peace she has chosen.\n\n" +
        "For once, nobody asks anything more of Kori.\n\n" +
        "The world grows quiet.",
        [],
        "Kori choosing to stay behind"
    );

    showEnding("ENDING 1: PEACE");
}

function goWithGabriel() {
    continueScene(
        "go with him.gif",
        "Kori follows Gabriel.\n\n" +
        "Neither of them says much as they walk. The farther they go, the quieter the world seems to become.",
        findTheTruth,
        "Kori walking with Gabriel"
    );
}

/* THE GRAVEYARD */

function findTheTruth() {
    clearSceneTimers();
    document.body.classList.add("gloomy");
    setChapter("ACT 3", "A Place to Remember");

    continueScene(
        "the truth.gif",
        "The two of you arrive at a graveyard.\n\n" +
        "Kori slows down. She doesn't understand why Gabriel has brought her here.\n\n" +
        "He stands beside her, his eyes still full of tears.\n\n" +
        '"Kori..."',
        readGravestone,
        "Kori and Gabriel standing in a graveyard"
    );
}

function readGravestone() {
    continueScene(
        "the truth.gif",
        "Kori looks down at the gravestone in front of her.\n\n" +
        "Her name is carved into it.\n\n" +
        "She stares at the letters. They belong to her. She knows they do.\n\n" +
        "But why would her name be here?",
        rememberTheTruth,
        "Kori looking at her gravestone"
    );
}

function rememberTheTruth() {
    continueScene(
        "the truth.gif",
        "Fragments of a memory begin to return.\n\n" +
        "A familiar room.\nThe sound of glass breaking.\nA moment she had tried to forget.\n\n" +
        "Your older brother.\n\n" +
        "What happened that day finally comes back to you.\n\n" +
        "You were never going to return home.\n\n" +
        "You have been gone all this time.",
        gabrielComfortsKori,
        "Kori remembering the truth"
    );
}

/* ENDING 2 — THE TRUTH */

function gabrielComfortsKori() {
    clearSceneTimers();
    setChapter("ENDING 2", "The Truth");

    scene(
        "the end.gif",
        "Gabriel gently rests a hand on Kori's back.\n\n" +
        "Kori doesn't know how long she's been crying. Minutes? Hours? She can't tell anymore. Everything she'd just remembered keeps replaying in her head, and she doesn't know what to do with any of it.\n\n" +
        "Gabriel doesn't say anything. He doesn't try to make her feel better with words he knows won't be enough. He just stays.\n\n" +
        "Eventually, Kori's tears begin to slow. Her breathing settles, and the silence around them becomes easier to bear.\n\n" +
        "She wipes her face and finally looks up.\n\n" +
        "Gabriel is still there.\n\n" +
        "He hasn't left. Not once.\n\n" +
        "Kori looks at him for a moment, her eyes still sore from crying. She doesn't know what to say, so she doesn't say anything.\n\n" +
        "For now, it's enough that someone stayed.",
        [],
        "Gabriel comforting Kori"
    );

    showEnding("ENDING 2: THE TRUTH");
}

/* ENDING SCREEN */

function showEnding(endingName) {
    currentEnding = endingName;
    renderChoices();
}

startGame();
</script>
</body>
</html>
